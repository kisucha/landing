# 셸 스크립트 — 항상 LF (리눅스 서버 실행용)
*.sh    text eol=lf

# 텍스트 파일 — OS 자동
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.conf  text eol=lf

# Windows 전용 스크립트 — CRLF 유지
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 바이너리
*.png   binary
*.jpg   binary
*.svg   binary
