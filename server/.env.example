# Kisucha Studio — 서버 환경변수 예시
# 이 파일을 복사해 .env 파일을 생성하고 실제 값을 입력하세요

# MariaDB 연결 설정
DB_HOST=localhost
DB_PORT=3306
DB_USER=kisucha
DB_PASSWORD=your_db_password_here
DB_NAME=kisucha_studio

# 관리자 인증 (admin.html 로그인용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# JWT 서명 키 (최소 32자 이상의 랜덤 문자열)
JWT_SECRET=your_very_long_jwt_secret_key_here_min_32_chars

# 서버 포트 (기본값: 3000)
PORT=3000
